# LLM Configuration (DeepSeek / OpenAI-compatible)
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Embedding (local model, no API key needed)
# Uses BAAI/bge-small-zh-v1.5 by default, ~100MB download on first run
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ai_interviewer

# Redis (format: redis://:password@host:port/db)
REDIS_URL=redis://:password@localhost:6379/0

# LangFuse Observability (optional — leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# App
APP_ENV=development
UPLOAD_DIR=./data/uploads
CHROMA_PERSIST_DIR=./data/chroma
